# Single source of truth for externally-pinned versions.
#
# This file is sourced by bash scripts and included by the Makefile, so only
# use `KEY=value` lines and `#` comments. No quoting, no expansions.

# Most recent kernel and ebpf-for-windows releases the test suite is
# expected to run against. Consumed by internal/testutils and by
# scripts/update-kernel-deps.sh and scripts/update-efw-deps.sh.
CI_MAX_KERNEL_VERSION=7.1
CI_MAX_EFW_VERSION=1.0.0-rc2

# Oldest clang the bpf2go toolchain tests are compiled with. Must be one of
# the clang versions shipped by the pinned builder image
# (testdata/docker/VERSION).
CI_MIN_CLANG_VERSION=14
